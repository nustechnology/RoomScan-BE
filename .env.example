NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://roomscan:roomscan@localhost:5432/roomscan?schema=public
LOG_LEVEL=info
CORS_ORIGIN=*
TRUST_PROXY=

RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX_REQUESTS=120
RATE_LIMIT_APPLE_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_APPLE_AUTH_MAX_REQUESTS=20
RATE_LIMIT_REFRESH_AUTH_MAX_REQUESTS=10
RATE_LIMIT_REFRESH_AUTH_WINDOW_SECONDS=900

APPLE_CLIENT_ID=com.example.roomscan
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-another-32-character-secret
# 1 hour
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# 30 days
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Local yarn-dev shortcut only. Cannot be enabled outside NODE_ENV=development.
LOCAL_TEST_AUTH_ENABLED=false

# Object storage. `local` is an unsigned in-process fake used in development
# and tests. `minio` requires the bucket/endpoint/credentials below.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_SSL=false
# 15 minutes
STORAGE_UPLOAD_URL_TTL_SECONDS=900
# 1 minute
STORAGE_DOWNLOAD_URL_TTL_SECONDS=60
ASSET_MAX_MODEL_SIZE_BYTES=500000000
ASSET_MAX_THUMBNAIL_SIZE_BYTES=10000000

# MinIO provider example (S3-compatible). Uncomment and fill in to use MinIO,
# for example with `docker compose up minio -d`.
# STORAGE_PROVIDER=minio
# STORAGE_BUCKET=roomscan-assets
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=localhost:9000
# STORAGE_ACCESS_KEY_ID=roomscan
# STORAGE_SECRET_ACCESS_KEY=roomscan-minio-secret
# STORAGE_USE_SSL=false

POSTGRES_USER=roomscan
POSTGRES_PASSWORD=roomscan
POSTGRES_DB=roomscan
MINIO_ROOT_USER=roomscan
MINIO_ROOT_PASSWORD=roomscan-minio-secret
ROOMSCAN_PORT=3000
