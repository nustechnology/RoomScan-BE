NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://roomscan:roomscan@localhost:5432/roomscan?schema=public
LOG_LEVEL=info
CORS_ORIGIN=*
TRUST_PROXY=

RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX_REQUESTS=120
RATE_LIMIT_APPLE_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_APPLE_AUTH_MAX_REQUESTS=20
RATE_LIMIT_REFRESH_AUTH_MAX_REQUESTS=10
RATE_LIMIT_REFRESH_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_CREATE_WINDOW_SECONDS=900
RATE_LIMIT_INVITATION_CREATE_MAX_REQUESTS=20
RATE_LIMIT_INVITATION_ACCEPT_WINDOW_SECONDS=300
RATE_LIMIT_INVITATION_ACCEPT_MAX_REQUESTS=30
RATE_LIMIT_UPLOAD_SESSION_CREATE_WINDOW_SECONDS=900
RATE_LIMIT_UPLOAD_SESSION_CREATE_MAX_REQUESTS=30
RATE_LIMIT_DOWNLOAD_URL_WINDOW_SECONDS=300
RATE_LIMIT_DOWNLOAD_URL_MAX_REQUESTS=60

APPLE_CLIENT_ID=com.example.roomscan
# Optional numeric App Store id. When set, browser-opened invitation links
# advertise the iOS app through Safari's Smart App Banner.
APPLE_APP_STORE_ID=
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
AUTH_REFRESH_TOKEN_SECRET=replace-with-another-32-character-secret
# Base64 for exactly 32 bytes. Generate a unique value before deployment.
SYNC_CRYPTO_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# 1 hour
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# 30 days
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Local yarn-dev shortcut only. Cannot be enabled outside NODE_ENV=development.
LOCAL_TEST_AUTH_ENABLED=false

# Object storage. `local` is an unsigned in-process fake used in development
# and tests. `minio` requires the bucket/endpoint/credentials below.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_USE_SSL=false
# Optional. Only needed when STORAGE_ENDPOINT is not reachable by the clients
# that receive presigned upload/download URLs (e.g. it's a Docker-internal
# hostname). When set, presigned PUT/GET URLs are signed against this
# endpoint instead, while bucket/stat calls keep using STORAGE_ENDPOINT.
# Both default to STORAGE_ENDPOINT/STORAGE_USE_SSL when unset.
STORAGE_PUBLIC_ENDPOINT=
STORAGE_PUBLIC_USE_SSL=
# 15 minutes
STORAGE_UPLOAD_URL_TTL_SECONDS=900
# 1 minute
STORAGE_DOWNLOAD_URL_TTL_SECONDS=60
# Model scan files must be between 0 MB and 200 MB
ASSET_MIN_MODEL_SIZE_BYTES=0
ASSET_MAX_MODEL_SIZE_BYTES=200000000
ASSET_MAX_THUMBNAIL_SIZE_BYTES=10000000

# Invitation links. INVITATION_BASE_URL is the client-facing base used to
# build invitationUrl (a web deep link routed to the preview screen). The API
# also serves a browser fallback page at {INVITATION_BASE_URL}/invitations/{token}.
# 7 days
INVITATION_TTL_SECONDS=604800
INVITATION_BASE_URL=http://localhost:3000

# Cleanup jobs (src/jobs/, run via `yarn jobs:*`). Grace period added past an
# upload session's expiry before it's treated as stuck, and the max rows the
# orphan-asset cleanup job processes per run.
UPLOAD_SESSION_EXPIRY_GRACE_SECONDS=300
ORPHAN_ASSET_CLEANUP_BATCH_SIZE=200

# Transactional email. `log` writes to the application log (development/tests
# only). `smtp` requires SMTP_HOST, SMTP_USER and SMTP_PASS, for example the
# Mailtrap sandbox:
#   MAIL_PROVIDER=smtp
#   SMTP_HOST=sandbox.smtp.mailtrap.io
#   SMTP_PORT=2525
#   SMTP_USER=replace-with-mailtrap-username
#   SMTP_PASS=replace-with-mailtrap-password
MAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=RoomScan App <notifications@roomscan.app>

# MinIO provider example (S3-compatible). Uncomment and fill in to use MinIO,
# for example with `docker compose up minio -d`.
# STORAGE_PROVIDER=minio
# STORAGE_BUCKET=roomscan-assets
# STORAGE_REGION=us-east-1
# STORAGE_ENDPOINT=localhost:9000
# STORAGE_ACCESS_KEY_ID=roomscan
# STORAGE_SECRET_ACCESS_KEY=roomscan-minio-secret
# STORAGE_USE_SSL=false

POSTGRES_USER=roomscan
POSTGRES_PASSWORD=roomscan
POSTGRES_DB=roomscan
MINIO_ROOT_USER=roomscan
MINIO_ROOT_PASSWORD=roomscan-minio-secret
ROOMSCAN_PORT=3000
