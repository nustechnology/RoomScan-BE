{
  "name": "roomscan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready backend foundation for RoomScan",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24 <25",
    "yarn": ">=4.17.1 <5"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "yarn prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "yarn format:check && yarn lint && yarn typecheck && yarn test:run",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed:local": "tsx prisma/seed-local.ts",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "express-rate-limit": "8.6.0",
    "helmet": "8.1.0",
    "jose": "6.2.4",
    "minio": "8.0.5",
    "pg": "8.16.3",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "@vitest/coverage-v8": "4.1.7",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "prettier": "3.9.4",
    "prisma": "7.9.0",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.7"
  }
}
