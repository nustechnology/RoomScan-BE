generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  APPLE @map("apple")
}

enum ProjectRole {
  OWNER
  VIEWER
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  CONFLICT
}

enum AssetStatus {
  NONE
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum AssetType {
  MODEL
  THUMBNAIL
}

enum NoteColor {
  YELLOW
  RED
  BLUE
  GREEN
  ORANGE
  PURPLE
  CYAN
  GRAY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

enum SyncResourceType {
  PROJECT
  SCAN
  NOTE
  SCAN_ASSET
  PROJECT_ACCESS
}

enum SyncOperation {
  UPSERT
  DELETE
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  provider      AuthProvider
  providerId    String       @db.VarChar(255)
  email         String?      @db.VarChar(320)
  emailVerified Boolean      @default(false)
  displayName   String?      @db.VarChar(100)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  projects            Project[]
  projectAccesses     ProjectAccess[]
  refreshTokens       RefreshToken[]
  scans               Scan[]
  notes               Note[]
  invitations         Invitation[]         @relation("InvitationCreator")
  acceptedInvitations Invitation[]         @relation("InvitationAcceptor")
  scanAccesses        ScanAccess[]
  shareLinks          ShareLink[]
  idempotencyReceipts IdempotencyReceipt[]
  ownedSyncChanges    SyncChange[]         @relation("SyncChangeOwner")
  targetedSyncChanges SyncChange[]         @relation("SyncChangeTarget")
  syncConflicts       SyncConflict[]

  @@unique([provider, providerId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  jti       String    @unique @db.VarChar(36)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @db.VarChar(50)
  description  String?    @db.VarChar(500)
  ownerId      String     @db.Uuid
  revision     Int        @default(1)
  syncStatus   SyncStatus @default(SYNCED)
  lastSyncedAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  owner         User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  accesses      ProjectAccess[]
  scans         Scan[]
  invitations   Invitation[]
  shareLinks    ShareLink[]
  syncChanges   SyncChange[]
  syncConflicts SyncConflict[]

  @@index([ownerId, deletedAt, updatedAt, id])
  @@map("projects")
}

model ProjectAccess {
  id           String      @id @default(uuid()) @db.Uuid
  projectId    String      @db.Uuid
  userId       String      @db.Uuid
  role         ProjectRole @default(VIEWER)
  revision     Int         @default(1)
  invitationId String?     @db.Uuid
  shareLinkId  String?     @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  shareLink  ShareLink?  @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([userId, deletedAt, revokedAt, projectId])
  @@map("project_accesses")
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  projectId        String?          @db.Uuid
  scanId           String?          @db.Uuid
  createdById      String           @db.Uuid
  recipientEmail   String           @db.VarChar(320)
  tokenHash        String           @unique @db.VarChar(64)
  status           InvitationStatus @default(PENDING)
  expiresAt        DateTime
  sentAt           DateTime         @default(now())
  acceptedAt       DateTime?
  acceptedByUserId String?          @db.Uuid
  declinedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan         Scan?           @relation(fields: [scanId], references: [id], onDelete: Cascade)
  creator      User            @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy   User?           @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  accesses     ProjectAccess[]
  scanAccesses ScanAccess[]

  @@index([projectId, status])
  @@index([scanId, status])
  @@index([projectId, recipientEmail])
  @@index([scanId, recipientEmail])
  @@index([status, expiresAt])
  @@map("invitations")
}

model ScanAccess {
  id           String      @id @default(uuid()) @db.Uuid
  scanId       String      @db.Uuid
  userId       String      @db.Uuid
  role         ProjectRole @default(VIEWER)
  invitationId String?     @db.Uuid
  shareLinkId  String?     @db.Uuid
  acceptedAt   DateTime?
  revokedAt    DateTime?
  deletedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  scan       Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  shareLink  ShareLink?  @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@unique([scanId, userId])
  @@index([userId, deletedAt, revokedAt, scanId])
  @@map("scan_accesses")
}

model ShareLink {
  id          String   @id @default(uuid()) @db.Uuid
  projectId   String?  @db.Uuid
  scanId      String?  @db.Uuid
  createdById String   @db.Uuid
  tokenHash   String   @unique @db.VarChar(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scan     Scan?        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  creator  User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  accesses ScanAccess[]
  projectAccesses ProjectAccess[]

  @@index([projectId, revokedAt, expiresAt])
  @@index([scanId, revokedAt, expiresAt])
  @@map("share_links")
}

model Scan {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  createdById      String      @db.Uuid
  name             String      @db.VarChar(100)
  description      String?     @db.VarChar(500)
  thumbnail        String?     @db.VarChar(2048)
  assetStatus      AssetStatus @default(NONE)
  syncStatus       SyncStatus  @default(PENDING)
  modelVersion     Int         @default(1)
  revision         Int         @default(1)
  clientMutationId String?     @db.VarChar(128)
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User        @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assets  ScanAsset[]
  notes   Note[]
  accesses   ScanAccess[]
  invitations Invitation[]
  shareLinks  ShareLink[]

  @@unique([projectId, clientMutationId])
  @@index([projectId, deletedAt, createdAt, id])
  @@index([projectId, deletedAt, updatedAt, id])
  @@index([createdById])
  @@map("scans")
}

model ScanAsset {
  id                 String      @id @default(uuid()) @db.Uuid
  scanId             String      @db.Uuid
  assetType          AssetType
  revision           Int         @default(1)
  status             AssetStatus @default(PENDING)
  contentType        String      @db.VarChar(128)
  sizeBytes          Int
  checksum           String?     @db.VarChar(128)
  modelVersion       String?     @db.VarChar(64)
  storageKey         String      @db.VarChar(512)
  idempotencyKey     String?     @db.VarChar(128)
  uploadedAt         DateTime?
  uploadUrlExpiresAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, assetType])
  @@unique([scanId, idempotencyKey])
  @@index([scanId, deletedAt, status])
  @@map("scan_assets")
}

model Note {
  id           String    @id @default(uuid()) @db.Uuid
  scanId       String    @db.Uuid
  createdById  String    @db.Uuid
  title        String    @db.VarChar(50)
  content      String    @db.VarChar(2000)
  color        NoteColor
  position     Json
  orientation  Json?
  modelVersion String    @db.VarChar(64)
  revision     Int       @default(1)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  scan    Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([scanId, deletedAt, updatedAt, id])
  @@index([createdById])
  @@map("notes")
}

model IdempotencyReceipt {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  operation          String   @db.VarChar(64)
  parentScope        String   @db.VarChar(80)
  keyHash            String   @db.Char(64)
  requestHash        String   @db.Char(64)
  responseStatus     Int
  responseCiphertext Bytes
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operation, parentScope, keyHash])
  @@index([createdAt])
  @@map("idempotency_receipts")
}

model SyncChange {
  id           BigInt           @id @default(autoincrement())
  projectId    String           @db.Uuid
  ownerId      String           @db.Uuid
  targetUserId String?          @db.Uuid
  resourceType SyncResourceType
  resourceId   String           @db.Uuid
  operation    SyncOperation
  revision     Int
  syncStatus   SyncStatus
  data         Json?
  deletedAt    DateTime?
  changedAt    DateTime         @default(now())

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner      User           @relation("SyncChangeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  targetUser User?          @relation("SyncChangeTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  conflicts  SyncConflict[]

  @@index([projectId, id])
  @@index([ownerId, id])
  @@index([targetUserId, id])
  @@index([resourceType, resourceId, id])
  @@index([changedAt, id])
  @@map("sync_changes")
}

model SyncConflict {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String           @db.Uuid
  projectId       String           @db.Uuid
  resourceType    SyncResourceType
  resourceId      String           @db.Uuid
  serverRevision  Int
  refreshChangeId BigInt
  resolvedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  refreshChange SyncChange @relation(fields: [refreshChangeId], references: [id], onDelete: Restrict)

  @@unique([userId, resourceType, resourceId])
  @@index([userId, projectId, resolvedAt])
  @@index([refreshChangeId])
  @@map("sync_conflicts")
}
