generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  APPLE @map("apple")
}

enum ProjectRole {
  OWNER
  VIEWER
}

enum SyncStatus {
  PENDING
  SYNCING
  SYNCED
  FAILED
  CONFLICT
}

enum AssetStatus {
  NONE
  PENDING
  UPLOADING
  UPLOADED
  FAILED
}

enum AssetType {
  MODEL
  THUMBNAIL
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  provider      AuthProvider
  providerId    String       @db.VarChar(255)
  email         String?      @db.VarChar(320)
  emailVerified Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  projects        Project[]
  projectAccesses ProjectAccess[]
  refreshTokens   RefreshToken[]
  scans           Scan[]

  @@unique([provider, providerId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  jti       String    @unique @db.VarChar(36)
  userId    String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(50)
  description String?   @db.VarChar(500)
  ownerId     String    @db.Uuid
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner    User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  accesses ProjectAccess[]
  scans    Scan[]

  @@index([ownerId, deletedAt, updatedAt, id])
  @@map("projects")
}
model ProjectAccess {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @db.Uuid
  userId    String      @db.Uuid
  role      ProjectRole @default(VIEWER)
  revokedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, revokedAt, projectId])
  @@map("project_accesses")
}

model Scan {
  id               String      @id @default(uuid()) @db.Uuid
  projectId        String      @db.Uuid
  createdById      String      @db.Uuid
  name             String      @db.VarChar(100)
  description      String?     @db.VarChar(500)
  thumbnail        String?     @db.VarChar(2048)
  assetStatus      AssetStatus @default(NONE)
  syncStatus       SyncStatus  @default(PENDING)
  modelVersion     Int         @default(1)
  clientMutationId String?     @db.VarChar(128)
  deletedAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator User    @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assets  ScanAsset[]

  @@unique([projectId, clientMutationId])
  @@index([projectId, deletedAt, createdAt, id])
  @@index([createdById])
  @@map("scans")
}

model ScanAsset {
  id                 String      @id @default(uuid()) @db.Uuid
  scanId             String      @db.Uuid
  assetType          AssetType
  status             AssetStatus @default(PENDING)
  contentType        String      @db.VarChar(128)
  sizeBytes          Int
  checksum           String?     @db.VarChar(128)
  modelVersion       String?     @db.VarChar(64)
  storageKey         String      @db.VarChar(512)
  idempotencyKey     String?     @db.VarChar(128)
  uploadedAt         DateTime?
  uploadUrlExpiresAt DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, assetType])
  @@unique([idempotencyKey])
  @@index([scanId, status])
  @@map("scan_assets")
}
